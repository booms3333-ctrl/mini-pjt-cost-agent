# 실제 키를 적은 .env 파일은 절대 커밋하지 않습니다.
# 이 과정은 Amazon Bedrock을 사용합니다. OpenAI 키는 쓰지 않습니다.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# 참고 — 채팅 모델은 이제 하나가 아니라 9개 우선순위 목록(src/llm_utils.py의
# MODEL_PRIORITY, MODEL_FAILOVER.md 참고)이며 코드에 직접 박혀 있어 이 값을 읽어서
# 쓰지는 않습니다. 1순위가 재시도까지 실패해야 다음 순위로 페일오버합니다.
# BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# ── 클라우드 비용 API (실 계정 사용 시) ─────────────────────
# AWS_COST_EXPLORER_ROLE_ARN=
# GCP_BILLING_PROJECT_ID=
# AZURE_SUBSCRIPTION_ID=

# ── 알림 발송 (send_cost_alert 도구 사용 시) ────────────────
# SLACK_WEBHOOK_URL=

# ── 이상탐지 배치 알림 (이메일, src/batch.py) ────────────────
# 전부 채워야 실제 발송된다. 하나라도 비우면 배치는 정상 동작하되 이메일만
# 건너뛴다(탐지·기록은 이메일 설정과 무관하게 항상 됨).
# 네이버 메일 예시 — 2단계 인증을 켜야 하고, SMTP_PASSWORD는 로그인 비밀번호가
# 아니라 네이버ID > 보안설정 > 2단계 인증 관리 > 애플리케이션 비밀번호 관리에서
# 발급한 앱 비밀번호를 써야 한다(2단계 인증 켜지면 일반 비밀번호는 SMTP 차단됨).
# SMTP_HOST=smtp.naver.com
# SMTP_PORT=587
# SMTP_USERNAME=본인아이디@naver.com
# SMTP_PASSWORD=발급받은 애플리케이션 비밀번호
# NOTIFY_EMAIL_TO=알림받을이메일주소@example.com
# ANOMALY_BATCH_INTERVAL_SECONDS=86400

# ── Observability · Trace (패턴 11) ─────────────────────────
# 셋 다 설정하면 코드 변경 없이 모든 LangChain/LangGraph 호출이 LangSmith로
# 전송된다. 설정 안 해도 로컬 트레이스(data/traces/*.jsonl)는 항상 남는다.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=multicloud-cost-agent
